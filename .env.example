# Template for the payment gateway compose settings.
#
#   cp .env.example .env
#
# Compose reads .env automatically from the project root; .env itself is
# gitignored so local tweaks stay local. Without a .env, COMPOSE_PROFILES is
# unset and `docker compose up` starts NOTHING -- so copy this file first, or
# select profiles explicitly with `docker compose --profile all up`.

# ---------------------------------------------------------------------------
# Which services to launch.
# Comma-separated list of profiles. Leave a profile out and that service is
# not created, not started and not stopped by `docker compose up`/`down`.
#
#   bank,gateway  both (default)
#   all           both (shorthand)
#   bank          bank simulator only
#   gateway       gateway only -- set PAYMENTS_BANK_API_URL below to a bank
#                 reachable from inside the container
#   (empty)       nothing starts
#
# A one-off override without editing this file:
#   docker compose --profile gateway up
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=bank,gateway

# ---------------------------------------------------------------------------
# Host ports. Change these if something already occupies them locally.
# ---------------------------------------------------------------------------
GATEWAY_PORT=8090
BANK_PORT=8080
BANK_ADMIN_PORT=2525

# ---------------------------------------------------------------------------
# Gateway application configuration.
# ---------------------------------------------------------------------------
# Resolved over the compose network. When running the gateway profile alone
# against a bank on your host, use: http://host.docker.internal:8080
PAYMENTS_BANK_API_URL=http://bank_simulator:8080
PAYMENTS_SUPPORTED_CURRENCIES=GBP,USD,EUR
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
