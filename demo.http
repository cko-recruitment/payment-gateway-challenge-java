###
# @name Step6_RetriableError
# Card ending in 0 -> Bank returns 503
POST http://localhost:8090/api/v1/payments
Content-Type: application/json
Merchant-Id: merchant-123
Idempotency-Key: demo-retry-1

{
  "card_number": "4242424242424240",
  "expiry_month": 12,
  "expiry_year": 2027,
  "currency": "USD",
  "amount": 100,
  "cvv": "123"
}

###
# @name Step7_RetryAgain
# Same key - retries bank call
POST http://localhost:8090/api/v1/payments
Content-Type: application/json
Merchant-Id: merchant-123
Idempotency-Key: demo-retry-1

{
  "card_number": "4242424242424240",
  "expiry_month": 12,
  "expiry_year": 2027,
  "currency": "USD",
  "amount": 100,
  "cvv": "123"
}

###
# @name Step8_DeclinedPayment
# Card ending in even number -> Declined
POST http://localhost:8090/api/v1/payments
Content-Type: application/json
Merchant-Id: merchant-123
Idempotency-Key: demo-decline-1

{
  "card_number": "4242424242424242",
  "expiry_month": 12,
  "expiry_year": 2027,
  "currency": "USD",
  "amount": 100,
  "cvv": "123"
}

###
# @name Step9_GetById
# Use the id from Step2 response
GET http://localhost:8090/api/v1/payments/d6afa7a3-e112-469a-9fba-e401541cadcc
Merchant-Id: merchant-123

###
# @name Step10_GetByIdempotencyKey
GET http://localhost:8090/api/v1/payments/idempotency/demo-success-1
Merchant-Id: merchant-123

###
# @name Step11_SwaggerUI
GET http://localhost:8090/swagger-ui.html

###
# @name Step12_PrometheusMetrics
GET http://localhost:8090/actuator/prometheus

###
# @name Step13_HealthCheck
GET http://localhost:8090/actuator/health
