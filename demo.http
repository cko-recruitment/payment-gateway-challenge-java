###
# @name Step5_ValidationCacheHit
# Same key - cached validation error
POST http://localhost:8090/api/v1/payments
Content-Type: application/json
Merchant-Id: merchant-123
Idempotency-Key: demo-validation-1

{
  "card_number": "abc",
