{
  "dashboard": {
    "title": "Payment Gateway",
    "panels": [
      {
        "title": "QPS",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(payment_total[1m]))",
            "legendFormat": "QPS"
          }
        ]
      },
      {
        "title": "P99 Latency",
        "type": "stat",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(payment_latency_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ]
      }
    ]
  }
}
